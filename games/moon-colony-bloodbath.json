      {
        "id": "developments",
        "scope": "TABLE",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Ranger les Developments en pile face visible",
        "body": "Triés, à portée de main.",
        "quantities": [
          {
            "label": "Cartes Development",
            "value": 20,
            "unit": "cartes"
          }
        ]
      },
      {
        "id": "events",
        "scope": "TABLE",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Ranger les Events face visible, triés par numéro",
        "body": "Le plus petit numéro sur le dessus.",
        "quantities": [
          {
            "label": "Cartes Event",
            "value": 13,
            "unit": "cartes"
          }
        ]
      },
      {
        "id": "supply",
        "scope": "TABLE",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Laisser la réserve sur la table",
        "body": "L'argent, la nourriture et les habitants restants, ainsi que les caisses. Le jeu n'est pas limité par le matériel : s'il manque un jeton, remplacez-le."
      }
