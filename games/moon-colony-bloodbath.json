          {
            "label": "Habitants",
            "value": 30
          },
          {
            "label": "Argent",
            "value": 4
          },
          {
            "label": "Nourriture",
            "value": 4
          }
        ]
      },
      {
        "id": "perks",
        "scope": "PER_PLAYER",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Prendre ses Perks et ses jetons Action",
        "body": "Les Perks sont propres à votre scientifique : laissez-les en pile face visible dans votre zone.",
        "quantities": [
          {
            "label": "Perks",
            "value": 5,
            "unit": "cartes"
          },
          {
            "label": "Jetons Action",
            "value": 4
