          {
            "label": "Cartes Bâtiment",
            "value": 4,
            "unit": "cartes"
          }
        ]
      },
      {
        "id": "playmat",
        "scope": "PER_PLAYER",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Choisir un scientifique et prendre sa Base lunaire",
        "body": "Les scientifiques sont identiques. Posez sur le plateau les habitants, l'argent et la nourriture de départ.",
