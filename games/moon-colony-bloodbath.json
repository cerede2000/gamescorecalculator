      {
        "id": "robots",
        "scope": "TABLE",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Mélanger les Robots et poser leur jeton dessus",
        "quantities": [
          {
            "label": "Cartes Robot",
            "value": 20,
            "unit": "cartes"
          }
