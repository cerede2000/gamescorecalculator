            "value": 90,
            "unit": "cartes"
          }
        ]
      },
      {
        "id": "deal",
        "scope": "PER_PLAYER",
        "source": "Official Instruction Manual, Rio Grande Games 2024, p. 3",
        "title": "Recevoir sa main de départ",
