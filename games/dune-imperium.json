            "scope": "PARTICIPANT",
            "control": "keypad",
            "usedBy": "formula:victoryPoints",
            "step": 1
          }
        ],
        "derive": [
          {
            "id": "finalVictoryPoints",
            "value": {
              "op": "add",
              "args": [
                {
                  "op": "ref",
                  "id": "visibleVictoryPoints"
                },
                {
                  "op": "ref",
                  "id": "endgameIntrigueAdjustment"
                }
              ]
            }
          }
        ]
      }
    ],
